  m_Script: {fileID: 11500000, guid: 7235f038cdbe474fbc2f4af9116a0065, type: 3}
  m_Name: Villager_C_Skeptical
  m_EditorClassIdentifier: Macedon.Encounters::Macedon.Villagers.VillagerProfile
  displayName: Villager C
  ambientDialogue:
  - Another quiet day. That's usually when trouble starts.
  - Everyone complains about this village. Nobody leaves.
  - If you're looking for excitement, find it somewhere else.
  recruitReadyDialogue:
  - I didn't think you'd come back from that wolf alive. Fine. If you're going after the raiders, I'm coming.
  followingDialogue:
  - Don't make me regret this.
